{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.flagman5/rankreactor",
  "title": "RankReactor",
  "description": "Hosted RankReactor MCP: SEO articles, UGC video, keywords, analytics, and site audits.",
  "version": "1.1.0",
  "websiteUrl": "https://www.rankreactor.ai",
  "repository": {
    "url": "https://github.com/rankreactorai/rankreactorai-mcp",
    "source": "github",
    "id": "1394342934"
  },
  "icons": [
    {
      "src": "https://www.rankreactor.ai/logo.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    },
    {
      "src": "https://www.rankreactor.ai/apple-touch-icon.png",
      "mimeType": "image/png",
      "sizes": ["180x180"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://www.rankreactor.ai/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "RankReactor project API key sent as a Bearer token to https://www.rankreactor.ai/mcp.",
          "value": "Bearer {api_key}",
          "isRequired": true,
          "isSecret": true,
          "variables": {
            "api_key": {
              "description": "Generate in RankReactor Dashboard → API Key. The full value is shown once (rr_live_...).",
              "isRequired": true,
              "isSecret": true,
              "placeholder": "rr_live_..."
            }
          }
        }
      ]
    }
  ]
}
